.create-merge table pbir_inspector_bronze (Id:string, TestedFilePath:string, RulesFilePath:string, CompletionTime:string, Verbose:bool, Results:dynamic, RepositoryId:string, BranchName:string, LogicalId:string, CommitId:string, CommittedBy:string, Timestamp:string, ReportName:string) 
.create-merge table tabular_editor_bronze (RepositoryId:string, BranchName:string, Timestamp:string, CommitId:string, CommittedBy:string, LogicalId:string, Results:string, SemanticModelName:string, TmdlFileName:string) 
.create-merge table pq_lint_bronze (RepositoryId:string, BranchName:string, Timestamp:string, CommitId:string, CommittedBy:string, LogicalId:string, Results:dynamic, SemanticModelName:string, TmdlFileName:string) 
.create-merge table pq_lint_tests_silver (Id:long, BusinessKey:string, Name:string, Description:string, Source:string) 
.create-merge table pbir_inspector_tests_silver (Id:long, BusinessKey:string, Name:string, Description:string, Source:string) 
.create-merge table tabular_editor_tests_silver (Id:long, BusinessKey:string, Name:string, Description:string, Source:string) 
.create-merge table tests_silver_combined (Id:long, BusinessKey:string, Name:string, Description:string, Source:string) 
.create-merge table tabular_editor_commits_silver (RepositoryId:string, CommitId:string, CommittedBy:string, BranchName:string, LogicalId:string, ArtifactName:string, Type:string, Date:datetime) 
.create-merge table pbir_inspector_commits_silver (RepositoryId:string, CommitId:string, CommittedBy:string, BranchName:string, LogicalId:string, ArtifactName:string, Type:string, Date:datetime) 
.create-merge table pq_lint_commits_silver (RepositoryId:string, CommitId:string, CommittedBy:string, BranchName:string, LogicalId:string, ArtifactName:string, Type:string, Date:datetime) 
.create-merge table commits_silver_combined (Id:long, RepositoryId:string, CommitId:string, CommittedBy:string, BranchName:string, LogicalId:string, ArtifactName:string, Type:string, Date:datetime) 
.create-merge table pbir_inspector_test_results_silver (Id:long, CommitsId:long, TestsId:long, SeverityId:int, Actual:string, Expected:string, Details:string, Passed:int, Date:datetime, Time:timespan) 
.create-merge table tabular_editor_test_results_silver (Id:long, CommitsId:long, TestsId:long, SeverityId:int, Actual:string, Expected:string, Details:string, Passed:int, Date:datetime, Time:timespan) 
.create-merge table pq_lint_test_results_silver (Id:long, CommitsId:long, TestsId:long, SeverityId:int, Actual:string, Expected:string, Details:string, Passed:int, Date:datetime, Time:timespan) 
.create-merge table test_results_silver_combined (Id:long, CommitsId:long, TestsId:long, SeverityId:int, Actual:string, Expected:string, Details:string, Passed:int, Date:datetime, Time:timespan) 
.create-or-alter function with (folder = "Bronze to Silver", docstring = "Add PQLint Tests", skipvalidation = "true") fnParsePQLintTest() {
    pq_lint_bronze
    | extend raw = todynamic(Results)                           // safe parse; null on bad JSON
    | extend jsonData = case(
        isnotnull(array_length(raw)), raw,                      // already an array
        isnull(raw), dynamic([]),                               // bad/empty JSON → empty array (skip)
        pack_array(raw)                                         // single object → wrap into array
    )
    | mv-expand element = jsonData
    | where isnotnull(element) and not(isnull(element.ID))                                   // drop any nulls
    | project 
        ID = element.ID,
        Name = tostring(element.Name),
        Description = tostring(element.Description)
    | extend 
        BusinessKey = strcat('PQLINT_',ID),
        Source = 'PQ Lint'
    | project 
        Id = hash(BusinessKey),
        BusinessKey,
        Name,
        Description,
        Source
}
.create-or-alter function with (folder = "Bronze to Silver", docstring = "Add PBIR Inspector Tests", skipvalidation = "true") fnParsePBIRInspectorTest() {
    pbir_inspector_bronze
    | extend jsonData = parse_json(Results)   // Convert to dynamic (JSON object/array)
    | mv-expand element = jsonData             // Split array into one row per element
    | project 
        BusinessKey = strcat('PBIRInspector_',tostring(element.RuleId)),
        Name        = tostring(element.RuleName),
        Description = tostring(element.RuleDescription),
        Source      = "PBIR Inspector"
    | project 
        Id = hash(BusinessKey),
        BusinessKey,
        Name,
        Description,
        Source
}
.create-or-alter function with (folder = "Combined", skipvalidation = "true") fnPQLintToCombined() {
    pq_lint_tests_silver
    | project 
        Id,
        BusinessKey,
        Name,
        Description,
        Source = "PQ Lint"
    | distinct Id, BusinessKey, Name, Description, Source
}
.create-or-alter function with (folder = "Combined", skipvalidation = "true") fnPBIRInspectorToCombined() {
    pbir_inspector_tests_silver
    | project 
        Id,
        BusinessKey,
        Name,
        Description,
        Source = "PBIR Inspector"
    | distinct Id, BusinessKey, Name, Description, Source
}
.create-or-alter function with (folder = "Bronze to Silver", docstring = "Add Commit from PBIR Inspector", skipvalidation = "true") fnParsePBIRInspectorCommit() {
    pbir_inspector_bronze
    | project 
        RepositoryId,
        CommitId,
        CommittedBy,
        BranchName,
        ReportName,
        LogicalId,
        Timestamp
    | extend 
        ArtifactName = ReportName,
        Type = 'Report',
        TSYear = toint(substring(Timestamp, 0, 4)),
        TSMonth = toint(substring(Timestamp, 4, 2)),
        TSDay = toint(substring(Timestamp, 6, 2)),
        TSHour = toint(substring(Timestamp, 9, 2)),
        TSMinute = toint(substring(Timestamp, 11, 2)),
        TSSecond = toint(substring(Timestamp, 13, 2))        
    | project 
        RepositoryId,
        CommitId,
        CommittedBy,
        BranchName,
        LogicalId,
        ArtifactName,
        Type,
        Date = todatetime(strcat(TSYear,'-',TSMonth,'-',TSDay,' 00:00:00Z'))
}
