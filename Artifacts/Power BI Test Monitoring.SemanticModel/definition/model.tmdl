model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

/// Data comes from the Eventhouse in Microsoft Fabric
queryGroup KQL

	annotation PBI_QueryGroupOrder = 2

queryGroup Functions

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Commits","Tests","Test Results","Eventhouse_Cluster_URL","Database","Days_Since_Filter","Severity","Timezones","Calendar","_Measures"]

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop"]

annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":[]}

annotation BestPracticeAnalyzer_ExternalRuleFiles = ["C:\\Users\\JohnKerski\\OneDrive - Kerski Family\\Documents\\Git\\pbi-teams-more-analytic-support\\Rules\\BPARules.json"]

annotation __TEdtr = 1

annotation __PBI_ServiceStoredInTmdl = reserved

ref table 'Test Results'
ref table Tests
ref table Commits
ref table Severity
ref table Timezones
ref table Calendar
ref table _Measures

ref cultureInfo en-US

