			partition Severity = m
				mode: import
				source =
						let
						    // Create a table with columns for severity and states
						    #"Created Severity State Table" = #table(
						        {"SeverityId", "State","Order"},
						        {
						            {1, "Informational",3},
						            {2, "Warning",2},
						            {3, "Error",1}
						        }
						    ),
						    // Define appropriate data types for each column in the table
						    #"Updated Column Types In Table" = Table.TransformColumnTypes(
						        #"Created Severity State Table",
						        {
						            {"SeverityId", Int64.Type},
						            {"State", type text},
						            {"Order", Int32.Type}
						        }
						    )
						in
						    #"Updated Column Types In Table"

